# ====================================================================
# NagarDrishti 3D Platform - Environment Variables Template
# ====================================================================
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or paste your service_role key into frontend code.

# Cesium Ion Access Token (Geospatial 3D Engine)
VITE_CESIUM_TOKEN=your_cesium_ion_token_here

# Supabase API Credentials (Project Settings -> API)
# Use the Public 'anon' key for client-side queries.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Compatibility aliases
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
